        <mxCell id="agendaText1" parent="agenda1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacingLeft=6;spacingTop=2;fontColor=#1F2937;" value="&lt;ul style=&quot;margin:0;padding-left:18px;&quot;&gt;&lt;li&gt;Functional Requirements&lt;/li&gt;&lt;li&gt;Non-Functional Requirements&lt;/li&gt;&lt;li&gt;Rough Estimation&lt;/li&gt;&lt;li&gt;Database Schema&lt;/li&gt;&lt;li&gt;REST APIs&lt;/li&gt;&lt;li&gt;System Architecture&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="10" y="32" as="geometry" />
        </mxCell>
        <mxCell id="fr1" parent="1" style="swimlane;rounded=1;arcSize=6;whiteSpace=wrap;html=1;startSize=32;fillColor=#2C7A7B;fontColor=#FFFFFF;fontStyle=1;fontSize=13;strokeColor=#1F5B5B;strokeWidth=1;swimlaneFillColor=#FFFFFF;" value="Functional Requirements" vertex="1">
          <mxGeometry height="260" width="450" x="130" y="300" as="geometry" />
        </mxCell>
        <mxCell id="frText1" parent="fr1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;spacingLeft=10;fontColor=#1F2937;" value="&lt;ul style=&quot;margin:0;padding-left:18px;&quot;&gt;&lt;li&gt;User enters a long URL.&lt;/li&gt;&lt;li&gt;System validates the URL.&lt;/li&gt;&lt;li&gt;User clicks the short URL.&lt;/li&gt;&lt;li&gt;System finds the original URL.&lt;/li&gt;&lt;li&gt;System returns the shortened URL.&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="220" width="540" x="10" y="32" as="geometry" />
        </mxCell>
        <mxCell id="nf1" parent="1" style="swimlane;rounded=1;arcSize=6;whiteSpace=wrap;html=1;startSize=32;fillColor=#B7472A;fontColor=#FFFFFF;fontStyle=1;fontSize=13;strokeColor=#8C3720;strokeWidth=1;swimlaneFillColor=#FFFFFF;" value="Non-Functional Requirements" vertex="1">
          <mxGeometry height="260" width="470" x="655" y="301" as="geometry" />
        </mxCell>
        <mxCell id="nfText1" parent="nf1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;spacingLeft=10;fontColor=#1F2937;" value="&lt;ul style=&quot;margin:0;padding-left:18px;&quot;&gt;&lt;li&gt;High Availability (99.9% uptime)&lt;/li&gt;&lt;li&gt;Low Latency (&amp;lt;100 ms redirection)&lt;/li&gt;&lt;li&gt;High Scalability (Millions of URLs &amp;amp; requests)&lt;/li&gt;&lt;li&gt;Secure Communication (HTTPS &amp;amp; URL validation)&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="220" width="540" x="10" y="32" as="geometry" />
        </mxCell>
        <mxCell id="cap1" parent="1" style="swimlane;rounded=1;arcSize=6;whiteSpace=wrap;html=1;startSize=32;fillColor=#B7791F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;strokeColor=#8A5D14;strokeWidth=1;swimlaneFillColor=#FFFFFF;" value="Capacity Estimation — Servers" vertex="1">
