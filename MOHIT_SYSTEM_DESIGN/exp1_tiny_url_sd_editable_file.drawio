        <mxCell id="agenda1" parent="1" style="swimlane;rounded=1;arcSize=8;whiteSpace=wrap;html=1;startSize=32;fillColor=#2C7A7B;fontColor=#FFFFFF;fontStyle=1;fontSize=14;strokeColor=#1F5B5B;strokeWidth=1;swimlaneFillColor=#FFFFFF;" value="Contents" vertex="1">
