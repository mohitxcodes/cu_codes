        <mxCell id="capText1" parent="cap1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;spacingLeft=10;fontColor=#1F2937;" value="Peak requests/sec = 3,500 req/sec&lt;br&gt;1 server handles = 1,000 req/sec&lt;br&gt;Servers needed = 3,500 / 1,000 = 4 servers" vertex="1">
          <mxGeometry height="220" width="540" x="10" y="32" as="geometry" />
